# Navigation for the Omnistat documentation (sphinx-external-toc).
# Each captioned subtree renders as a bold section header with its pages
# listed directly beneath it.
root: index
subtrees:
  - entries:
      - file: release-notes.md
        title: Release notes
      - file: what-is-omnistat
        title: What is Omnistat?
  - caption: Install
    entries:
      - file: system-mode/system-install
        title: System mode Installation
      - file: user-mode/user-install
        title: User mode Installation
  - caption: Conceptual
    entries:
      - file: metrics
        title: Omnistat metrics
      - file: advanced-profiling
        title: Advanced Profiling
  - caption: How-to 
    entries:
      - file: system-mode/grafana
        title: Grafana integration in system mode     
      - file: user-mode/jobs
        title: Running jobs in user mode
      - file: user-mode/analysis
        title: Analyzing results collected in user mode
      - file: site.frontier
        title: Running jobs on ORNL Frontier
      - file: site.lux
        title: Running jobs on ORNL Lux
      - file: site.tuo
        title: Running jobs on LLNL Tuolumne
  - caption: Reference
    entries:
      - file: agents
        title: AI agent skills
      - file: developer/developers
        title: Developer Guide
  - caption: About
    entries:
      - file: license
