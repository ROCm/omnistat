[omnistat.collectors]

port = 8001
enable_rocm_smi = False
enable_amd_smi = True
enable_ras_ecc = False
enable_rms = True
enable_rocprofiler = False
enable_network = True
enable_vendor_counters = False
enable_host_metrics = True
enable_kernel_trace = False
enable_rccl_trace = False
enable_external = False

## Path to local ROCM install to access SMI library
rocm_path = /opt/rocm

## List of IPs allowed to query the collector (comma separated). By
## default, access will be restricted to the localhost (127.0.0.1).
## Expand this value to include IP of local Prometheus server.
allowed_ips = 127.0.0.1

[omnistat.collectors.rms]

host_skip = "login.*"
enable_annotations = True
job_detection_mode = file-based
job_detection_file = /tmp/omni_rmsjobinfo

[omnistat.collectors.host]
enable_proc_io_stats = False
cpu_load_sampling_interval = 0.05

[omnistat.collectors.rocprofiler]
profile = default

## Collect the number of free-running GPU cycles and the number of GPU active
## cycles. Both counters are collected from all GPUs on every sample.
[omnistat.collectors.rocprofiler.default]
sampling_mode = constant
counters = ["GRBM_COUNT", "GRBM_GUI_ACTIVE"]

## Collect total number of bytes read from HBM.
[omnistat.collectors.rocprofiler.hbm_read]
sampling_mode = constant
counters = ["FETCH_SIZE"]

## Collect total number of bytes read from and written to HBM. Cyclically
## assign the two counters to different GPU IDs.
##  - GPU IDs 0, 2... sample FETCH_SIZE
##  - GPU IDs 1, 3... sample WRITE_SIZE
## Requires at least 2 GPUs per node.
[omnistat.collectors.rocprofiler.hbm_gpuid]
sampling_mode = gpu-id
counters = [["FETCH_SIZE"], ["WRITE_SIZE"]]

## Collect total number of bytes read from and written to HBM. Alternate
## between counters on every sample.
##  - Sample 0: FETCH_SIZE
##  - Sample 1: WRITE_SIZE
##  - Sample 2: FETCH_SIZE
##  - Sample 3: WRITE_SIZE
##  - ...
[omnistat.collectors.rocprofiler.hbm_periodic]
sampling_mode = periodic
counters = [["FETCH_SIZE"], ["WRITE_SIZE"]]

## Collect L1 and L2 cache hit rate counters. The 5 TCP counters needed for
## L1 hit rate exceed the 4 counter registers per TCP block, so they are
## split into two groups and cyclically assigned to different GPU IDs. TCC
## counters (L2) use a separate hardware block and can be collected alongside
## TCP counters without conflict.
##
## Counter sets are cyclically assigned to GPU IDs:
##  - GPU IDs 0, 2... sample L1 read/write misses + L2 counters
##  - GPU IDs 1, 3... sample L1 atomic misses + L2 counters
## Requires at least 2 GPUs per node.
[omnistat.collectors.rocprofiler.cache_l1l2_hitrate_gpuid]
sampling_mode = gpu-id
counters = [
        [
            "TCP_TOTAL_CACHE_ACCESSES_sum",
            "TCP_TCC_READ_REQ_sum",
            "TCP_TCC_WRITE_REQ_sum",
            "TCC_HIT_sum",
            "TCC_MISS_sum"
        ],
        [
            "TCP_TOTAL_CACHE_ACCESSES_sum",
            "TCP_TCC_ATOMIC_WITH_RET_REQ_sum",
            "TCP_TCC_ATOMIC_WITHOUT_RET_REQ_sum",
            "TCC_HIT_sum",
            "TCC_MISS_sum"
        ]
    ]

## Collect L2 cache hit rate counters only. Both counters are collected from
## all GPUs on every sample.
[omnistat.collectors.rocprofiler.cache_l2_hitrate]
sampling_mode = constant
counters = ["TCC_HIT_sum", "TCC_MISS_sum"]

## Path to external data collector
[omnistat.collectors.external]
script = /path/to/my_metrics.sh
timeout_secs = 10

[omnistat.query]

prometheus_url = http://localhost:9090
system_name = My Snazzy System


#--
# User-mode Settings
#--

[omnistat.usermode]

# settings for pushing data to external victoria-metrics instance (enabled via external_victoria = True)

external_victoria = False
external_victoria_endpoint = victoria.endpoint.org
external_victoria_port = 8440
# external_proxy=http://proxy.myorg.org:3128/

# settings when spinning up a local victoria-metrics instance within a job (enabled via external_victoria = False)

victoria_binary = /path-to-victoria-metrics-install/victoria-metrics-prod
victoria_datadir = data_prom
victoria_logfile = vic_server.log


## Bind user-mode Omnistat monitor and VictoriaMetrics to specific cores.
## Requires numactl. When these options are not set, no binding is enforced.
##
## Note: you can also control these settings via environment variables:
## OMNISTAT_EXPORTER_COREBINDING, OMNISTAT_VICTORIA_COREBINDING

# exporter_corebinding = 0
# victoria_corebinding = 1

## SSH key to launch user-mode Omnistat. For backward compatibility with
## older versions of Omnistat; no longer needed with v1.5 or later.
ssh_key = ~/.ssh/id_rsa

#--
# Optimizer Settings
#--

[omnistat.optimize]

## Set mode = energy to enable automated GPU clock frequency optimization.
## Omnistat will monitor application FOM data and step clock frequencies
## down from max, converging on the lowest frequency where performance
## remains within max_performance_drop of the baseline.
##
## Leave this section commented out or set mode to any other value to disable.

mode = energy

## Python class implementing the optimization algorithm.
## Must be a subclass of omnistat.optimizer_base.BaseOptimizer.
## Default uses the Phase I hierarchical step-down search.

optimizer_class = omnistat.optimizer_stepdown.StepDownOptimizer

## Port on which the optimizer process listens for FOM data forwarded
## from standalone.py instances on each job node.

optimizer_port = 8002

## Full path to the system command used to adjust GPU clock frequencies.
## The command must accept the interface:
##   <clock_cmd> -clock [sclk|mclk] -limit [min|max] -value <MHz> [-gpu <index>]

clock_cmd = sudo /usr/local/bin/set_gpu_clockfreq.sh

## Comma-separated list of available SCLK frequencies in MHz, ascending.
## The last (highest) value is treated as the default/max frequency.

sclk_frequencies = auto

## Minimum number of FOM samples to collect at each frequency before
## evaluating performance and deciding whether to step down further.

min_observe_samples = 20

## Whether a higher or lower FOM value indicates better performance.
## Use "higher" for throughput/FLOPS-style metrics (default).
## Use "lower" for time/latency-style metrics.

fom_direction = higher

## Maximum allowed performance degradation (as a percentage of the baseline
## FOM mean) before reverting to the previous frequency and converging.

max_performance_drop = 5.0

## Memory (in MB) allocated for the in-process FOM history cache used
## by the feedback control system.

fom_history_cache_mb = 10

## Optional label for FOM units (e.g. "GFLOPS", "seconds", "iterations/sec").
## Passed to the optimizer for logging/display. No default.

# fom_units =

[omnistat.optimize.frequencies.gfx950]
sclk_min = 501
sclk_max = 2200


